{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TGCampaigner",
  "mainBinaryName": "tgcampaigner",
  "version": "0.1.2",
  "identifier": "tgcampaigner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TGCampaigner",
        "width": 800,
        "height": 600,
        "maximized": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "TGCampaigner",
    "homepage": "https://tgcampaigner.com",
    "copyright": "© 2026 TGCampaigner",
    "license": "Proprietary",
    "category": "Utility",
    "shortDescription": "Desktop Telegram campaign operations console.",
    "longDescription": "TGCampaigner is a desktop control panel for session management, campaign workflows, telemetry, and license-backed operation tooling.",
    "resources": [
      "resources/backend"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
